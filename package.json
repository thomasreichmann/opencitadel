{
  "name": "opencitadel",
  "private": true,
  "description": "Community server hosting, server browser and plugin ecosystem for Deadlock",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "tsc -b && node --test --test-reporter=spec \"packages/*/dist/**/*.test.js\" \"plugins/*/dist/**/*.test.js\"",
    "e2e": "tsc -b && node scripts/e2e.mjs",
    "master": "node packages/master/dist/cli.js",
    "host": "node packages/host/dist/cli.js",
    "browser": "node packages/client/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.9.0"
}
